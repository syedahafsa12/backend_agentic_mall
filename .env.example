# PostgreSQL connection (Supabase-hosted for this POC, but the app talks to it
# as plain PostgreSQL via `pg` — no Supabase SDK for data access).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Auth only (signup/login/session verification) — NOT used for data access.
# From the Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Model provider (see src/server/agent/model-provider.ts).
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Base URL this backend is served from (used to build absolute URLs for
# demo-merchant REST/web endpoints and for CORS allow-list against the frontend).
APP_BASE_URL=http://localhost:3000

# Command used to launch the Merchant B MCP server as a child process (stdio transport).
MERCHANT_B_MCP_COMMAND=npx
MERCHANT_B_MCP_ARGS=tsx,scripts/mcp-servers/merchant-b-server.ts

# /connect endpoint
# Optional dev-only opt-in to test a local site (exact origins, comma separated).
CONNECT_ALLOW_LOCAL=
# Optional: secret used to derive stable per-domain ownership tokens (otherwise a local .connect-secret file is created).
CONNECT_SECRET=
# Optional: skip LLM classification in /connect (faster, deterministic dev/test runs).
CONNECT_NO_LLM=
# Shortcut URLs the /connect inspector page links to.
NEXT_PUBLIC_LUNA_URL=
NEXT_PUBLIC_CADENCE_URL=
# Used by scripts/seed.ts when seeding the Luna Apparel demo merchant.
LUNA_APPAREL_BASE_URL=

# Agent (server-side only). Any Mistral chat model with tool calling works.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_BASE_URL=

# Optional alt model provider (see src/server/agent/cloudflare-provider.ts).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=

# Signs referral links (src/server/referral/ledger.ts).
REFERRAL_SIGNING_SECRET=

# NEW — required once frontend and backend are separate deployments:
# the frontend origin(s) allowed to call this API (comma separated), for CORS.
ALLOWED_ORIGINS=http://localhost:3001
